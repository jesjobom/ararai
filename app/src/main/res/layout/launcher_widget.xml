<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/launcher_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/launcher_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B8CDD3"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/launcher_widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/launcher_widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:paddingTop="7dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/launcher_widget_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="6dp"
        android:textColor="#8DD1FF"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/launcher_widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="7dp"
            android:textColor="#B8CDD3"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/launcher_widget_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/widget_launcher_refresh"
            android:padding="7dp"
            android:src="@drawable/ic_launcher_widget_refresh"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
